# ============================================================
# Application
# ============================================================
APP_NAME=KESCO-DigitalTwin
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true


# ============================================================
# Logging
# ============================================================
LOG_DIR=log
LOG_BACKUP_DAYS=60


# ============================================================
# Files
# ============================================================
FILES_DIR=files
DEFAULT_ESS_ID=KESCO_ESS_001
PREPROCESSED_RETENTION_DAYS=60


# ============================================================
# Scheduler
# ============================================================
# 매일 원하는 시간에 1회 실행
# 예: 매일 새벽 2시 30분
SCHEDULE_HOUR=10
SCHEDULE_MINUTE=55
SCHEDULE_SECOND=0

# 0  = 오늘 데이터 처리
# -1 = 전날 데이터 처리
TARGET_DATE_OFFSET_DAYS=-1


# ============================================================
# Local Database - AI 결과 DB
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kesco_digitaltwin
DB_USER=kesco
DB_PASSWORD=kesco

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false


# ============================================================
# Remote Database - 관제시스템 원본 DB
# ============================================================
DB_REMOTE_HOST=192.168.110.111
DB_REMOTE_PORT=15432
DB_REMOTE_NAME=deps_emc
DB_REMOTE_USER=emc_viewer
DB_REMOTE_PASSWORD=qwer!@#$

# DB_REMOTE_HOST=localhost
# DB_REMOTE_PORT=5432
# DB_REMOTE_NAME=kesco_monitoring_fake
# DB_REMOTE_USER=kesco
# DB_REMOTE_PASSWORD=kesco


# ==============================
# File retention settings
# ==============================

# raw 원본 데이터 보관 기간
# 예: 100이면 raw 데이터를 최대 100일치까지만 보관
RAW_RETENTION_DAYS=10

# 전처리 데이터 rolling 기간
# 예: 7이면 preprocess 폴더에는 최근 7일치 기준으로 유지
ROLLING_PREPROCESS_DAYS=7

# AI 실행 최소 전처리 일수
# 예: 7이면 전처리 데이터가 7일치 모이기 전에는 AI 실행 안 함
AI_MIN_PREPROCESS_DAYS=7


# ==============================
# AI model settings
# ==============================

# 사용할 모델 제조사
# 현재 업로드 코드 기준: samsung 또는 LG
AI_MODEL_MAKER=samsung

# 모델 폴더 위치
# 나중에 KERI-DigitalTwin-main/model 폴더로 넣을 예정
AI_MODEL_ROOT=model