# ============================================================
# KESCO AI API Server Environment Example
# ============================================================
# 이 파일은 환경변수 예시 파일입니다.
#
# 실제 실행 시에는 이 파일을 복사해서 아래 파일 중 하나로 사용하세요.
#
# 개발 환경:
#   .env.dev
#
# 운영/기본 환경:
#   .env
#
# 주의:
#   .env, .env.dev 파일은 GitHub에 올리지 않습니다.
# ============================================================


# ============================================================
# Application
# ============================================================

# 애플리케이션 이름
APP_NAME=KESCO-DigitalTwin

# 애플리케이션 버전
APP_VERSION=1.0.0

# 서버 바인딩 주소
# 0.0.0.0 = 외부 접속 허용
# 127.0.0.1 = 내 PC에서만 접속
APP_HOST=0.0.0.0

# FastAPI 서버 포트
APP_PORT=8000

# 디버그 모드
DEBUG=false


# ============================================================
# Logging
# ============================================================

# 로그 저장 폴더
LOG_DIR=log

# 로그 보관 기간
LOG_BACKUP_DAYS=60


# ============================================================
# File Storage
# ============================================================

# Parquet 파일 저장 루트 폴더
FILES_DIR=files

# Parquet 저장 경로에 사용할 기본 ESS ID
# 실제 관제 DB에서 ess_id/site_id가 넘어오면 그 값을 우선 사용하고,
# 없으면 이 값을 사용합니다.
DEFAULT_ESS_ID=KESCO_ESS_001

# preprocessed 데이터 보관 기간
# raw 데이터에서 다시 만들 수 있으므로 preprocessed 데이터는 일정 기간 후 자동 삭제합니다.
# 예: 60이면 60일 지난 files/preprocessed/{ess_id}/{date}/ 폴더 삭제
PREPROCESSED_RETENTION_DAYS=60


# ============================================================
# Scheduler
# ============================================================

# 매일 AI 파이프라인을 자동 실행할 시간
SCHEDULE_HOUR=0
SCHEDULE_MINUTE=0
SCHEDULE_SECOND=30

# 스케줄 실행 시 처리할 데이터 날짜 기준
#
# 0  = 오늘 데이터 처리
# -1 = 전날 데이터 처리
#
# 운영에서는 보통 새벽에 전날 데이터를 처리하므로 -1 권장
TARGET_DATE_OFFSET_DAYS=-1


# ============================================================
# Database - AI Result DB
# ============================================================
# 우리 AI 서버가 직접 관리하는 결과 DB입니다.
#
# 저장 테이블:
# - anomaly_score
# - pipeline_run_log
# - monitoring_battery_sample 개발용 예시 테이블
# - battery 개발용 테스트 테이블

DB_HOST=localhost
DB_PORT=5432
DB_NAME=kesco_digitaltwin
DB_USER=kesco
DB_PASSWORD=kesco

# SQLAlchemy connection pool 설정
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# SQL 로그 출력 여부
# true로 하면 SQL 쿼리가 터미널에 출력됩니다.
DB_ECHO=false


# ============================================================
# Remote Database - Monitoring System Source DB
# ============================================================
# 관제시스템 원본 데이터를 읽어올 DB입니다.
#
# 개발 중에는 로컬 DB를 관제시스템 DB처럼 사용하기 위해
# DB_*와 같은 값을 넣을 수 있습니다.
#
# 실제 운영에서는 관제시스템 DB 접속 정보로 변경해야 합니다.

DB_REMOTE_HOST=localhost
DB_REMOTE_PORT=5432
DB_REMOTE_NAME=kesco_digitaltwin
DB_REMOTE_USER=kesco
DB_REMOTE_PASSWORD=kesco