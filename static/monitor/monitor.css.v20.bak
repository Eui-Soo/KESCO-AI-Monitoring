:root{
  --bg:#f6f9fd; --panel:#ffffff; --panel2:#fbfdff; --line:#dce6f2; --line2:#edf2f8;
  --text:#0b1b36; --muted:#738399; --blue:#0969e8; --blue2:#e9f2ff; --deep:#08285f;
  --green:#17b26a; --green-bg:#eafaf1; --orange:#f59e0b; --orange-bg:#fff6df; --red:#ef4444; --red-bg:#fff0f0;
  --purple:#7c3aed; --purple-bg:#f3ecff; --shadow:0 16px 38px rgba(23,43,77,.08); --soft:0 8px 22px rgba(23,43,77,.06);
}
*{box-sizing:border-box} body{margin:0;font-family:"Pretendard","Segoe UI",Arial,sans-serif;background:linear-gradient(180deg,#fbfdff 0%,#f4f8fd 100%);color:var(--text);font-size:15px;overflow:hidden}.app-shell{height:100vh;display:grid;grid-template-columns:300px 1fr}.sidebar{background:linear-gradient(180deg,#fff 0%,#f9fcff 100%);border-right:1px solid var(--line);position:relative;display:flex;flex-direction:column;overflow:hidden}.brand-area{height:96px;display:flex;align-items:center;gap:18px;padding:0 28px;border-bottom:1px solid var(--line2)}.kesco-logo{font-size:34px;font-weight:900;letter-spacing:-2px;color:#07398f;line-height:1;white-space:nowrap}.kesco-logo i{font-style:normal;color:#e02020;display:inline-block;transform:skew(-13deg);text-shadow:12px -8px 0 rgba(224,32,32,.16)}.brand-title{font-size:24px;font-weight:850;letter-spacing:-.7px;color:#092765}.nav-list{padding:24px 24px 0;display:flex;flex-direction:column;gap:10px}.nav-item{height:68px;border:0;background:transparent;border-radius:12px;display:flex;align-items:center;gap:18px;padding:0 24px;color:#24364f;font-size:19px;font-weight:750;cursor:pointer;text-align:left}.nav-item:hover{background:#f2f7ff}.nav-item.active{background:linear-gradient(180deg,#eff6ff,#e8f1ff);box-shadow:inset 0 0 0 1px #d7e8ff;color:var(--blue)}.nav-icon{width:28px;height:28px;display:inline-flex;align-items:center;justify-content:center;font-size:25px;color:inherit}.ess-illustration{position:absolute;left:0;right:0;bottom:96px;height:370px;opacity:.82;pointer-events:none}.ess-box{position:absolute;left:36px;bottom:78px;width:230px;height:145px;border:2px solid #c7daf2;border-radius:6px;transform:skewY(22deg);background:linear-gradient(135deg,rgba(255,255,255,.5),rgba(232,242,255,.18));box-shadow:inset 0 0 0 10px rgba(255,255,255,.35)}.ess-box div{position:absolute;top:18px;width:44px;height:108px;border:2px solid #c7daf2;border-radius:4px}.ess-box div:nth-child(1){left:68px}.ess-box div:nth-child(2){left:120px}.ess-box div:nth-child(3){left:172px}.ess-box span{position:absolute;left:24px;top:54px;color:#a7c3e8;font-size:42px}.grid-floor{position:absolute;left:-28px;right:-20px;bottom:8px;height:130px;background:linear-gradient(150deg,rgba(151,188,231,.36) 1px,transparent 1px),linear-gradient(25deg,rgba(151,188,231,.34) 1px,transparent 1px);background-size:42px 28px;transform:perspective(260px) rotateX(55deg);transform-origin:bottom}.wind{position:absolute;border-left:4px solid #c7daf2;height:105px;bottom:202px}.wind:before{content:"";position:absolute;left:-36px;top:-16px;width:72px;height:72px;border:4px solid #c7daf2;border-radius:50%;border-color:#c7daf2 transparent transparent transparent;transform:rotate(18deg)}.w1{left:168px;height:145px;bottom:224px}.w2{left:92px;height:84px;bottom:212px;opacity:.72}.sidebar-footer{margin-top:auto;padding:0 28px 24px;display:flex;flex-direction:column;gap:12px}.sidebar-footer div{height:44px;border:1px solid var(--line);border-radius:12px;background:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 14px;color:#6b7a90;box-shadow:var(--soft)}.sidebar-footer b{font-size:13px}.sidebar-footer span{font-weight:800;color:#16315a}.main-panel{min-width:0;display:flex;flex-direction:column}.topbar{height:84px;background:rgba(255,255,255,.9);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 30px;backdrop-filter:blur(8px)}.topbar-left{font-size:0}.topbar-right{display:flex;align-items:center;gap:18px;margin-left:auto}.status-pill{height:46px;border:1px solid var(--line);background:#fff;border-radius:12px;display:flex;align-items:center;gap:9px;padding:0 18px;color:#17243b;box-shadow:0 6px 16px rgba(44,63,93,.04);white-space:nowrap}.status-pill b{font-size:16px}.status-pill.ok{background:#eefbf4;border-color:#d3f3df;color:#126f42}.status-pill.ok span{color:#18b565}.status-pill.time{font-size:17px}.user-chip{display:flex;gap:10px;align-items:center;color:#526177}.avatar{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#e8eef7,#fff);border:1px solid #d7e0ea}.content{flex:1;overflow:auto;padding:28px 34px 26px}.footerbar{height:62px;border-top:1px solid var(--line);background:rgba(255,255,255,.82);display:flex;align-items:center;gap:0;color:#758296;font-size:15px}.footerbar span{padding:0 44px;border-right:1px solid var(--line)}.footerbar b{color:#0969e8}.page{max-width:1680px;margin:0 auto}.dashboard-grid{display:grid;grid-template-columns:1fr 1fr 1.18fr;gap:20px;margin-bottom:22px}.hero-card,.card{background:rgba(255,255,255,.93);border:1px solid var(--line);border-radius:16px;box-shadow:var(--soft)}.hero-card{height:214px;padding:28px;display:flex;align-items:center;justify-content:space-between;overflow:hidden}.hero-left{display:flex;align-items:center;gap:28px}.hero-icon{width:88px;height:88px;border-radius:24px;background:linear-gradient(135deg,#e8f2ff,#dcecff);box-shadow:0 16px 30px rgba(9,105,232,.13);display:flex;align-items:center;justify-content:center;color:var(--blue);font-size:45px}.hero-title{font-size:21px;font-weight:750;margin-bottom:14px}.hero-value{font-size:58px;font-weight:900;line-height:1;color:var(--blue);letter-spacing:-2px}.hero-value.green{color:#008b6d}.korea-map{width:145px;height:150px;opacity:.75;background:radial-gradient(circle at 50% 12%,#0969e8 3px,transparent 4px),radial-gradient(circle at 55% 35%,#0969e8 3px,transparent 4px),radial-gradient(circle at 40% 58%,#0969e8 3px,transparent 4px),radial-gradient(circle at 62% 75%,#0969e8 3px,transparent 4px);border:2px dashed #79aef4;clip-path:polygon(59% 0,79% 15%,70% 32%,85% 50%,68% 66%,74% 88%,47% 100%,35% 77%,12% 84%,22% 60%,9% 42%,31% 24%,37% 8%)}.ai-chip-art{width:132px;height:132px;border-radius:50%;background:radial-gradient(circle,#f8fbff 0,#edf5ff 45%,transparent 46%);position:relative;opacity:.8}.ai-chip-art:after{content:"AI";position:absolute;inset:38px;border:2px solid #bdcce0;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:30px;font-weight:900;color:#9aa9bc}.stat-split{height:214px;padding:32px}.stat-split h3{margin:0 0 30px;font-size:25px}.split-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:0}.split-box{text-align:center;border-right:1px solid var(--line)}.split-box:last-child{border-right:0}.split-label{font-size:24px;font-weight:800;margin-bottom:18px}.split-num{font-size:50px;font-weight:900;line-height:1}.green{color:var(--green)}.orange{color:var(--orange)}.red{color:var(--red)}.blue{color:var(--blue)}.dash-main{display:grid;grid-template-columns:1.2fr .95fr;gap:22px}.panel{background:#fff;border:1px solid var(--line);border-radius:17px;box-shadow:var(--soft);overflow:hidden}.panel-title{height:72px;padding:0 28px;display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--line2);font-size:24px;font-weight:850}.mini-icon{font-size:22px;color:var(--blue)}.ranking-table{padding:0 16px 16px}.ranking-table table,.data-table{width:100%;border-collapse:collapse}.ranking-table th,.ranking-table td,.data-table th,.data-table td{border-bottom:1px solid var(--line2);padding:18px 16px;text-align:left}.ranking-table th,.data-table th{color:#5a677b;font-weight:800;font-size:14px}.ranking-table td{font-size:17px}.rank-num{font-weight:900;color:#e11d48}.rank-num:nth-child(n){color:#e11d48}.score-badge,.state-badge{height:38px;min-width:78px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;font-weight:900}.score-badge.bad{background:var(--red-bg);color:#dc2626;border:1px solid #fecaca}.score-badge.warn{background:var(--orange-bg);color:#c77b00;border:1px solid #fde7b1}.score-badge.good{background:var(--green-bg);color:#128a52;border:1px solid #cdeedc}.state-badge{font-size:15px}.state-badge.bad{background:var(--red-bg);color:#dc2626;border:1px solid #fecaca}.state-badge.warn{background:var(--orange-bg);color:#c77b00;border:1px solid #fde7b1}.state-badge.good{background:var(--green-bg);color:#128a52;border:1px solid #cdeedc}.state-badge.gray{background:#f1f4f8;color:#667085;border:1px solid #e1e7ef}.more-link{height:64px;display:flex;align-items:center;justify-content:center;color:var(--blue);font-size:18px;font-weight:800;gap:10px}.side-stack{display:flex;flex-direction:column;gap:18px}.priority-list,.alarm-list{padding:12px 20px 20px}.priority-item,.alarm-item{height:68px;display:grid;grid-template-columns:44px 1fr auto 20px;align-items:center;border-bottom:1px solid var(--line2);gap:12px}.priority-item:last-child,.alarm-item:last-child{border-bottom:0}.rank-circle{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;background:var(--red)}.rank-circle.r2{background:#ffb020}.rank-circle.r3{background:#ffd15c}.priority-name{font-size:17px;font-weight:800}.priority-reason{font-size:16px;font-weight:850}.chev{font-size:25px;color:#95a3b7}.alarm-item{grid-template-columns:34px 1fr auto 20px;height:58px}.alarm-icon{font-size:24px}.alarm-name{font-size:17px;font-weight:750}.alarm-value{font-weight:900}.sites-layout{display:grid;grid-template-columns:1fr 340px;gap:26px}.page-heading{display:flex;align-items:flex-end;gap:20px;margin:18px 0 30px}.page-heading h1{font-size:33px;margin:0;letter-spacing:-1px}.page-heading p{margin:0 0 6px;color:#748199;font-weight:700}.filter-card{background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:var(--soft);padding:22px;display:grid;grid-template-columns:1.6fr repeat(5,1fr);gap:18px;margin-bottom:22px}.input,.select{height:54px;border:1px solid var(--line);border-radius:12px;background:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 16px;color:#657289;font-weight:700}.tabs{height:48px;display:inline-grid;grid-template-columns:repeat(5,110px);background:#f2f6fb;border:1px solid var(--line);border-radius:24px;padding:3px;margin-bottom:16px}.tab{border:0;border-radius:22px;background:transparent;font-weight:800;color:#516073;cursor:pointer}.tab.active{background:#fff;color:var(--blue);box-shadow:0 3px 10px rgba(17,40,80,.08)}.table-card{background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:var(--soft);overflow:hidden}.data-table th{height:58px}.data-table td{height:62px;font-size:16px}.check{width:24px;height:24px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:#25c878;color:#fff;font-weight:900}.dash{width:24px;height:24px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:#e8edf4;color:#778397;font-weight:900}.pagination{height:72px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;border-top:1px solid var(--line2);color:#667085}.pages{display:flex;gap:10px}.page-btn{width:38px;height:38px;border:1px solid var(--line);border-radius:10px;background:#fff;font-weight:800;color:#3e4c61}.page-btn.active{background:var(--blue);border-color:var(--blue);color:#fff}.summary-card{background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:var(--soft);padding:24px;margin-bottom:22px}.summary-card h3{font-size:22px;margin:0 0 20px}.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.summary-box{height:90px;border:1px solid var(--line2);border-radius:13px;background:#fbfdff;display:flex;align-items:center;gap:16px;padding:0 16px}.summary-box .big{font-size:31px;font-weight:900;color:var(--blue)}.quick-buttons{display:grid;grid-template-columns:1fr 1fr;gap:12px}.quick-buttons button,.sort-item{height:46px;border-radius:10px;border:1px solid var(--line);background:#fff;font-weight:850;color:#3a4a60}.quick-buttons .bad{color:#dc2626;border-color:#fecaca;background:#fff8f8}.quick-buttons .warn{color:#c77b00;border-color:#f7d790;background:#fffdf5}.quick-buttons .purple{color:#7c3aed;border-color:#d9c2ff;background:#fbf7ff}.quick-buttons .blue-btn{color:var(--blue);border-color:#add0ff;background:#f7fbff}.sort-list{display:flex;flex-direction:column;gap:10px}.sort-item{text-align:left;padding:0 16px;display:flex;align-items:center;justify-content:space-between}.detail-page{display:grid;grid-template-columns:1fr 460px;gap:26px}.detail-left{min-width:0}.breadcrumb{display:flex;align-items:center;gap:13px;color:#66758c;font-weight:800;margin:6px 0 22px}.detail-title{display:flex;align-items:center;gap:18px;margin-bottom:20px}.site-icon{width:76px;height:76px;border-radius:14px;background:linear-gradient(135deg,#ecf5ff,#fff);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:40px;color:var(--blue)}.detail-title h1{font-size:34px;letter-spacing:-1.2px;margin:0;display:flex;align-items:center;gap:16px}.level-tag{font-size:14px;background:var(--blue2);color:var(--blue);border:1px solid #cbe0ff;border-radius:9px;padding:8px 12px}.level-buttons{display:flex;gap:12px;margin-bottom:24px}.level-buttons button{height:42px;width:88px;border:1px solid var(--line);background:#fff;border-radius:9px;color:#6a768a;font-weight:850}.level-buttons button.active{background:var(--blue);border-color:var(--blue);color:#fff;box-shadow:0 8px 18px rgba(9,105,232,.22)}.module-grid{display:grid;grid-template-columns:1.05fr 1fr 1fr 1fr;gap:22px;margin-bottom:20px}.info-card,.warn-card,.small-card{background:#fff;border:1px solid var(--line);border-radius:15px;box-shadow:var(--soft);padding:22px}.info-card{grid-row:span 1}.card-title{display:flex;align-items:center;gap:9px;font-size:20px;font-weight:900;margin-bottom:16px}.info-card dl{display:grid;grid-template-columns:110px 1fr;gap:9px 16px;margin:0;font-size:15px}.info-card dt{color:#64748b;font-weight:800}.info-card dd{margin:0;font-weight:850}.module-graphic{float:right;width:62px;height:100px;border-radius:10px;border:1px solid #d7e5f7;background:linear-gradient(180deg,#eaf3ff,#f8fbff);display:grid;place-items:center;color:var(--blue);font-size:34px}.warn-card{background:linear-gradient(135deg,#fff,#fff8ee);border-color:#f6d9b1}.warn-card .alert-symbol{font-size:42px;color:#f97316;margin:10px 0}.warn-card h2{font-size:38px;margin:0;color:#f08a00}.warn-card p{font-size:16px;font-weight:750;line-height:1.55;color:#38465a}.metric-value{font-size:40px;font-weight:950;margin-top:22px}.metric-value span{font-size:18px;color:#6b778c;font-weight:800}.small-card p{color:#69758b;font-weight:750;line-height:1.7}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:24px}.wide-card{background:#fff;border:1px solid var(--line);border-radius:15px;box-shadow:var(--soft);padding:22px;margin-bottom:20px}.cell-map{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.cell{height:72px;border-radius:10px;border:1px solid var(--line);background:#f6faf8;padding:10px 12px;position:relative}.cell b{font-size:14px}.cell strong{display:block;font-size:22px;margin-top:6px}.cell.good{background:#f0faf3;border-color:#d7f0df}.cell.warn{background:#fff8e8;border-color:#f5dfb2}.cell.bad{background:#fff1f1;border-color:#f1b7b7;box-shadow:0 0 0 1px rgba(239,68,68,.12)}.cell .badge{position:absolute;right:9px;top:8px;font-size:12px;border-radius:8px;padding:4px 7px;font-weight:900}.badge.good{background:#ddf7e7;color:#168051}.badge.warn{background:#ffefc7;color:#c77900}.badge.bad{background:#ffe0e0;color:#e11d48}.legend{display:flex;gap:18px;align-items:center;justify-content:flex-end;color:#6a768a;font-size:14px;font-weight:800;margin-bottom:12px}.dot{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:5px}.dot.good{background:var(--green)}.dot.warn{background:var(--orange)}.dot.bad{background:var(--red)}.risk-table{width:100%;border-collapse:collapse}.risk-table th,.risk-table td{padding:13px;border-bottom:1px solid var(--line2);text-align:left}.risk-table th{color:#607086}.line-chart{height:184px;position:relative;background:linear-gradient(180deg,#fff,#fbfdff);border-radius:12px;overflow:hidden}.line-chart svg{width:100%;height:100%}.recommend-item{display:grid;grid-template-columns:30px 1fr auto;gap:12px;align-items:center;padding:16px 0;border-bottom:1px solid var(--line2)}.recommend-item:last-child{border-bottom:0}.action-btn{height:34px;border:0;border-radius:9px;padding:0 14px;font-weight:900}.action-btn.bad{background:#fff1f1;color:#df2525}.action-btn.warn{background:#fff5db;color:#c77b00}.action-btn.info{background:#eef5ff;color:var(--blue)}.right-drawer{background:#fff;border-left:1px solid var(--line);margin:-28px -34px -26px 0;padding:28px;box-shadow:-12px 0 34px rgba(23,43,77,.05)}.drawer-head{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:1px solid var(--line2);padding-bottom:20px;margin-bottom:20px}.drawer-head h2{font-size:24px;margin:0 0 8px}.close{font-size:28px;color:#1a2b46}.drawer-score{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-bottom:18px}.drawer-score div{padding:18px 12px;text-align:center;border-right:1px solid var(--line2)}.drawer-score div:last-child{border-right:0}.drawer-score b{display:block;color:#65748a;font-size:13px;margin-bottom:10px}.drawer-score strong{font-size:27px}.drawer-info{border:1px solid var(--line);border-radius:14px;padding:18px;margin-bottom:18px}.drawer-info dl{display:grid;grid-template-columns:90px 1fr 90px 1fr;gap:12px 14px;margin:0}.drawer-info dt{color:#66758c;font-weight:850}.drawer-info dd{margin:0;font-weight:900}.mini-heatmap{border:1px solid var(--line);border-radius:14px;padding:18px;margin-bottom:18px}.mini-cells{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.mini-cell{height:54px;border-radius:8px;border:1px solid var(--line);display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:12px;font-weight:850}.mini-cell strong{font-size:14px}.bar-legend{height:8px;border-radius:8px;background:linear-gradient(90deg,#20b26b,#85d575,#f7d96f,#f59e0b,#ef4444);margin:16px 10px 6px}.drawer-actions{display:flex;gap:12px;margin-top:24px}.primary{height:48px;border:0;background:var(--blue);color:#fff;border-radius:10px;font-weight:900;padding:0 22px;box-shadow:0 10px 22px rgba(9,105,232,.25)}.secondary{height:48px;border:1px solid var(--line);background:#fff;color:#374256;border-radius:10px;font-weight:900;padding:0 22px}.tree-panel{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px;margin-bottom:18px}.tree-title{font-weight:900;font-size:18px;margin-bottom:12px}.tree ul{list-style:none;margin:0;padding-left:18px}.tree li{padding:7px 0;color:#22324a;font-weight:750}.tree .active{background:var(--blue);color:#fff;border-radius:8px;padding:8px 10px;margin-left:-10px;display:inline-block}.tree .open{color:var(--blue)}.empty-page{height:calc(100vh - 210px);display:grid;place-items:center}.empty-card{background:#fff;border:1px solid var(--line);border-radius:18px;box-shadow:var(--soft);padding:60px;text-align:center}.empty-card h1{margin:0 0 12px}.hidden{display:none!important}@media(max-width:1500px){.app-shell{grid-template-columns:260px 1fr}.dashboard-grid{grid-template-columns:1fr 1fr}.stat-split{grid-column:1 / -1}.detail-page{grid-template-columns:1fr}.right-drawer{margin:0;border:1px solid var(--line);border-radius:16px}.module-grid{grid-template-columns:1fr 1fr}.sites-layout{grid-template-columns:1fr}.footerbar span{padding:0 22px}.topbar-right{gap:10px}.status-pill{padding:0 12px}}

/* ============================================================
   v4 - Site selection flow
   ============================================================ */
.clickable-row { cursor: pointer; transition: background .16s ease, transform .16s ease, box-shadow .16s ease; }
.clickable-row:hover { background: #f5f9ff !important; }
.priority-item.clickable-row:hover { transform: translateY(-1px); box-shadow: 0 10px 24px rgba(15, 23, 42, .08); }
.data-table tr.clickable-row:hover td,
.ranking-table tr.clickable-row:hover td { color: #0b5bd3; }
.table-action {
  height: 32px;
  padding: 0 12px;
  border: 1px solid #cfe0f8;
  border-radius: 10px;
  background: linear-gradient(180deg, #ffffff, #f4f8ff);
  color: #0969e8;
  font-size: 12px;
  font-weight: 900;
  white-space: nowrap;
  cursor: pointer;
}
.table-action:hover { background: #0b6fea; color: #fff; border-color: #0b6fea; }
.detail-title-row {
  display: grid !important;
  grid-template-columns: 64px minmax(0, 1fr) 230px;
  align-items: center;
  gap: 16px;
}
.detail-title-row h1 { margin: 0; }
.site-subline {
  margin: 8px 0 0;
  color: #64748b;
  font-size: 14px;
  font-weight: 800;
}
.site-picker {
  display: flex;
  flex-direction: column;
  gap: 7px;
  padding: 10px 12px;
  border: 1px solid #dbe7f6;
  border-radius: 16px;
  background: linear-gradient(180deg,#ffffff,#f8fbff);
  box-shadow: 0 10px 24px rgba(9, 105, 232, .08);
}
.site-picker span {
  font-size: 12px;
  font-weight: 900;
  color: #64748b;
}
.site-picker select {
  width: 100%;
  border: 0;
  outline: none;
  background: transparent;
  color: #0b1b36;
  font-size: 14px;
  font-weight: 900;
  cursor: pointer;
}
@media (max-width: 1280px){
  .detail-title-row { grid-template-columns: 56px 1fr; }
  .site-picker { grid-column: 1 / -1; max-width: 320px; }
}


/* --------------------------------------------------------------------------
   v18 sidebar hierarchy tree
   -------------------------------------------------------------------------- */
.sidebar-tree-card{
  position:relative;
  z-index:2;
  margin:18px 24px 0;
  padding:16px 14px 12px;
  border:1px solid var(--line);
  border-radius:16px;
  background:rgba(255,255,255,.94);
  box-shadow:0 10px 24px rgba(23,43,77,.07);
  max-height:430px;
  overflow:auto;
}
.sidebar-tree-title{
  display:flex;
  align-items:center;
  gap:10px;
  height:34px;
  margin-bottom:10px;
  color:#17243b;
}
.sidebar-tree-title span{color:var(--blue);font-size:19px}.sidebar-tree-title b{font-size:18px;font-weight:900;letter-spacing:-.3px}.sidebar-tree-refresh{margin-left:auto;width:28px;height:28px;border:0;border-radius:9px;background:#f2f7ff;color:#4b6387;font-size:16px;font-weight:900;cursor:pointer}.sidebar-tree-refresh:hover{background:#e7f0ff;color:var(--blue)}.sidebar-tree-empty{font-size:13px;font-weight:750;color:#738399;padding:12px 4px}.tree-site-line{display:flex;align-items:center;gap:8px;min-height:28px;font-weight:900;color:#10213c}.tree-site-line span:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.tree-meta-line{font-size:12px;font-weight:800;color:#738399;margin:0 0 8px 22px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.tree-list{list-style:none;margin:0;padding:0}.tree-list.depth-1{margin-left:12px;padding-left:14px;border-left:2px solid #e4ecf6}.tree-list.depth-2{margin-left:12px;padding-left:14px;border-left:2px solid #e4ecf6}.tree-list.depth-3{margin-left:12px;padding-left:14px;border-left:2px solid #e4ecf6}.tree-node{width:100%;min-height:32px;border:0;background:transparent;border-radius:10px;display:flex;align-items:center;gap:8px;padding:6px 9px;color:#2b3a52;font-size:15px;font-weight:850;cursor:pointer;text-align:left}.tree-node span{width:20px;color:#63728a}.tree-node b{font-weight:850;white-space:nowrap}.tree-node:hover{background:#f2f7ff}.tree-node.active{background:#eaf2ff;color:var(--blue);box-shadow:inset 0 0 0 1px #d6e7ff}.tree-node.active span{color:var(--blue)}.tree-node.module.active{background:linear-gradient(180deg,#1174ff,#075de0);color:white;box-shadow:0 8px 16px rgba(9,105,232,.2)}.tree-node.module.active span{color:white}.tree-dot{width:10px;height:10px;border-radius:50%;display:inline-flex;flex:0 0 10px}.tree-dot.normal,.tree-legend i.normal{background:#17b26a}.tree-dot.warning,.tree-legend i.warning{background:#f59e0b}.tree-dot.abnormal,.tree-legend i.abnormal{background:#ef4444}.tree-dot.offline,.tree-legend i.offline{background:#98a2b3}.tree-legend{display:flex;flex-wrap:wrap;gap:8px 10px;margin-top:12px;padding-top:10px;border-top:1px solid var(--line2);font-size:12px;font-weight:850;color:#526177}.tree-legend span{display:flex;align-items:center;gap:5px}.tree-legend i{width:9px;height:9px;border-radius:50%;display:inline-block}.sidebar-tree-card::-webkit-scrollbar{width:8px}.sidebar-tree-card::-webkit-scrollbar-thumb{background:#d8e3f0;border-radius:20px}.sidebar-tree-card::-webkit-scrollbar-track{background:transparent}
@media (max-height: 880px){.sidebar-tree-card{max-height:330px}.ess-illustration{opacity:.18}}
